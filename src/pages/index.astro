---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contacts from '../components/Contacts.astro';
import { business, nav } from '../data/business.js';

const title = 'Труни, хрести Львів — Компанія Кленолист';
const description = 'Труни, хрести, вінки, похоронні покривала та ритуальний транспорт у Львові. Допоможемо з оформленням документів. Дзвоніть: +38 (067) 708-22-94.';
---
<Layout {title} {description}>
  <Header showAnchorButtons={true} />

  <main id="main">
    <div class="container-fluid px-0">
      <div class="row no-gutters">
        <div class="col-md-7 col-lg-8 col-xl-9">
          <div id="ShopBackground" role="img" aria-label="Магазин Кленолист у Львові"></div>
          <div id="ShopDescription">
            <div class="row align-items-center justify-content-center m-0">
              <div class="col-md-12 col-lg-8 text-center" id="ShopDescriptionBlock">
                <section aria-labelledby="about-heading">
                  <div class="col-12">
                    <h1 id="about-heading">Коротко про компанію «Кленолист»</h1>
                    <br />
                  </div>
                  <div class="col-md-10 offset-md-1">
                    <p>Труни, хрести, вінки, похоронні покривала та ритуальний транспорт — усе необхідне для гідного прощання. Зателефонуйте за номером <a href={`tel:${business.phoneSalon}`}>{business.phoneSalonDisplay}</a> — ми підкажемо актуальні ціни й допоможемо з оформленням документів. м. Львів.</p>
                    <p>Домовини імпортуємо з України, Польщі, Угорщини та Румунії — від простих моделей до саркофагів (труна з двох половинок). Хрести — католицькі, православні та дитячі. Також у наявності: вінки з живих та штучних квітів, покривала на тіло, покриття на стіл під труну, тумби (замість хреста), нагріб (деревʼяне обрамлення могили) та лампадки.</p>
                  </div>
                </section>
              </div>
            </div>
          </div>
        </div>
        <aside class="col-xl-3 col-lg-4 col-md-5 text-center" id="Schedule" aria-label="Графік та контакти">
          <section>
            <h2 class="h4 pt-3">Графік роботи</h2>
            <div class="row no-gutters">
              <div class="col text-center">
                <span class="schedule-day">ПН</span>&nbsp;:&nbsp;<span class="schedule-time">09:00-18:00</span><br />
                <span class="schedule-day">ВТ</span>&nbsp;:&nbsp;<span class="schedule-time">09:00-18:00</span><br />
                <span class="schedule-day">СР</span>&nbsp;:&nbsp;<span class="schedule-time">09:00-18:00</span><br />
                <span class="schedule-day">ЧТ</span>&nbsp;:&nbsp;<span class="schedule-time">09:00-18:00</span><br />
                <span class="schedule-day">ПТ</span>&nbsp;:&nbsp;<span class="schedule-time">09:00-18:00</span><br />
                <span class="schedule-day">СБ</span>&nbsp;:&nbsp;<span class="schedule-time">09:00-18:00</span><br />
                <span class="schedule-day">НД</span>&nbsp;:&nbsp;<span class="schedule-time">09:00-18:00</span><br />
              </div>
            </div>
          </section>

          <section>
            <div class="row justify-content-center no-gutters">
              <div class="col-md-11">
                <h2 class="h4">Звʼязатися з нами</h2>
                <p>
                  <span class="font-weight-bold">УКРАЇНА, м. {business.address.addressLocality}</span><br />
                  <a href={business.mapsUrl} target="_blank" rel="noopener noreferrer">
                    <span>{business.address.streetAddress}</span>&nbsp;<i class="fa fa-2x fa-map-marker" aria-hidden="true"></i>
                  </a>
                  <br />
                  <span><span class="font-weight-bold">Салон:</span> <a href={`tel:${business.phoneSalon}`}>{business.phoneSalonDisplay}</a></span><br />
                  <span><span class="font-weight-bold">Виробництво:</span> <a href={`tel:${business.phoneProduction}`}>{business.phoneProductionDisplay}</a></span><br />
                  <span><span class="font-weight-bold">E-mail:</span> <a href={`mailto:${business.email}`}>{business.email}</a></span><br />
                </p>
                <p>
                  <span class="font-weight-bold">Поштова адреса для листів:</span><br />
                  <span>79000, м. Львів</span><br />
                  <span>вул. Венеціанова 15/8</span><br />
                </p>
              </div>
            </div>
          </section>
        </aside>
      </div>
    </div>

    <div class="container-fluid">
      <section aria-labelledby="services-heading">
        <h2 id="services-heading" class="py-5 text-center font-weight-bold">Наші товари та послуги</h2>
      </section>
      <div class="row justify-content-center text-center" id="ServicesRow">
        {nav.map((item) => (
          <div class="col-sm-4 col-md-3 col-lg-2">
            <a href={item.href}>
              <img src={item.heroImage} class="img-thumbnail" alt={`${item.label} Львів`} loading="lazy" decoding="async" />
            </a>
            <div>
              <h3 class="h4">{item.label}</h3>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="container-fluid p-0">
      <Contacts />
    </div>
  </main>

  <Footer />
</Layout>
