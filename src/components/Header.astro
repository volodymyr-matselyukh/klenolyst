---
import { business } from '../data/business.js';
const { showAnchorButtons = true } = Astro.props;
---
<header class="container-fluid top-menu py-3">
  <div class="row align-items-center">
    <div class="col-sm-5 col-md-5 col-lg-3 text-center py-3 pb-md-2 pb-sm-2" id="LogoDiv">
      <a href="/" aria-label="Кленолист — на головну" class="logo-link">
        <img alt="Кленолист — ритуальні товари у Львові" src="/images/logo.png" width="240" height="80" class="logo-img" />
      </a>
    </div>
    <div class="col-sm-7 col-md-7 col-lg-6">
      <div class="row">
        <nav class="col-12 top-menu-links text-center" aria-label="Швидка навігація">
          {showAnchorButtons ? (
            <>
              <button type="button" class="link-button" data-scroll-to="ServicesRow">Послуги</button>
              <button type="button" class="link-button" data-scroll-to="MapAndContactsDiv">Контакти</button>
            </>
          ) : (
            <>
              <a href="/#ServicesRow">Послуги</a>
              <a href="/#MapAndContactsDiv">Контакти</a>
            </>
          )}
        </nav>
        <div class="col text-center">
          <span>
            <span>
              <i class="fa fa-mobile fa-2x" aria-hidden="true"></i>
              <span class="dont-wrap">Салон: <a href={`tel:${business.phoneSalon}`}>{business.phoneSalonDisplay}</a></span>
            </span>
            <br />
            <span class="dont-wrap">Виробництво: <a href={`tel:${business.phoneProduction}`}>{business.phoneProductionDisplay}</a></span>
          </span>
          <br />
          <span class="font-weight-bold text-uppercase">Телефонуйте цілодобово</span>
          <br />
          <span class="d-block d-lg-none">
            <i class="fa fa-envelope" aria-hidden="true"></i>
            <span class="text-uppercase"><a href={`mailto:${business.email}`}>{business.email}</a></span>
          </span>
        </div>
      </div>
    </div>
    <div class="col-lg-3 d-none d-lg-block">
      <div class="row text-center">
        <div class="col">
          <span class="text-uppercase">
            <i class="fa fa-envelope" aria-hidden="true"></i>
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </span>
        </div>
      </div>
    </div>
  </div>
</header>

{showAnchorButtons && (
  <script>
    document.querySelectorAll('[data-scroll-to]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-scroll-to');
        const target = document.getElementById(id);
        if (target) target.scrollIntoView({ behavior: 'smooth' });
      });
    });
  </script>
)}
